{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cemo-lp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Auto-referência do OpenNext: precisa ser igual ao nome do Worker.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cemo-lp"
    }
  ],
  // Vídeos (AV1/WebM + H.264/MP4) servidos por /v/ com suporte a Range; enviados por scripts/upload-videos.mjs.
  "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "cemo-videos" }],
  "images": {
    // Otimização de imagens do next/image (AVIF/WebP) via Cloudflare Images.
    // Sem este binding o Worker serve a imagem original, sem otimização.
    "binding": "IMAGES"
  },
  "vars": {
    // Lido em runtime pelo proxy (redirects/host) e pela API de leads.
    // SITE_ENV e NEXT_PUBLIC_SITE_URL também precisam estar nas variáveis de BUILD do Workers Builds.
    "SITE_ENV": "staging"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // PRODUÇÃO (oftalmologiacemo.com.br): Worker separado do staging, sem URL workers.dev. As rotas ficam
    // sobre o registro A com proxy que já existe (DNS e e-mail da UOL intocados); o deploy com elas é a troca
    // do WordPress pelo site novo. Voltar ao WordPress: apagar as duas rotas (docs/deploy-cloudflare.md).
    // Bindings e vars não são herdados entre ambientes: repetir aqui.
    "production": {
      "name": "cemo-producao",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "oftalmologiacemo.com.br/*", "zone_name": "oftalmologiacemo.com.br" },
        { "pattern": "www.oftalmologiacemo.com.br/*", "zone_name": "oftalmologiacemo.com.br" }
      ],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cemo-producao" }],
      "r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "cemo-videos" }],
      "images": { "binding": "IMAGES" },
      "vars": { "SITE_ENV": "production" },
      "observability": { "enabled": true }
    }
  }
}
