{
  "name": "cemo-lp",
  "version": "0.1.0",
  "description": "CEMO — novo ecossistema digital (Next.js)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "redirects:generate": "node scripts/generate-redirects.ts",
    "assets:optimize": "node scripts/optimize-images.mjs",
    "todos": "node scripts/list-todos.mjs",
    "redirects:check-targets": "node scripts/check-redirect-targets.ts",
    "build:e2e": "node -e \"process.env.SITE_ENV='production';process.env.NEXT_PUBLIC_SITE_URL='http://localhost:3100';require('child_process').execSync('npx next build',{stdio:'inherit',env:process.env})\"",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "node scripts/cloudflare-env.mjs echo verificacao-ok && npm run build && node scripts/cloudflare-env.mjs opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:whoami": "node scripts/cloudflare-env.mjs wrangler whoami"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contatop12/cemo-lp.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/contatop12/cemo-lp/issues"
  },
  "homepage": "https://github.com/contatop12/cemo-lp#readme",
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "potrace": "^2.1.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.11"
  }
}
