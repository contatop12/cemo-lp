# Ambiente do site: development | staging | production
# ATENÇÃO: SITE_ENV precisa existir no BUILD (metadata/robots estáticos) E em RUNTIME (proxy e API de leads).
# staging => noindex + Disallow: / ; production => indexável.
SITE_ENV=development

# URL pública canônica, sem barra final
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager (vazio = GTM desligado)
NEXT_PUBLIC_GTM_ID=

# Destino dos leads (server-side). Sem webhook em produção o formulário falha fechado
# e oferece o WhatsApp como alternativa.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Somente staging/testes: aceita leads em memória (descartados ao reiniciar) quando não há webhook.
# Nunca vale em SITE_ENV=production. Em "next dev" já é liberado automaticamente.
LEAD_PROVIDER=

# Fonte de conteúdo: fixtures (padrão) — futuramente sanity
CONTENT_SOURCE=fixtures
